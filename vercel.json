{
  "services": {
    "web": {
      "root": "frontend/",
      "buildCommand": "craco build",
      "outputDirectory": "build",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
